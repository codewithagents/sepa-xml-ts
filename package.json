{
  "name": "sepa-xml-ts",
  "version": "0.3.0",
  "description": "Type-safe SEPA payment file library for pain.001, with output validated against the official ISO 20022 XSD.",
  "license": "MIT",
  "author": "Benjamin Eckstein",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codewithagents/sepa-xml-ts.git"
  },
  "homepage": "https://github.com/codewithagents/sepa-xml-ts#readme",
  "bugs": "https://github.com/codewithagents/sepa-xml-ts/issues",
  "keywords": [
    "sepa",
    "pain.001",
    "iso20022",
    "credit-transfer",
    "xml",
    "zod",
    "typescript"
  ],
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "sideEffects": false,
  "files": [
    "dist",
    "schemas"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./xsd": {
      "import": "./dist/xsd.js",
      "types": "./dist/xsd.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fallow": "fallow",
    "fallow:audit": "fallow audit",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "fast-xml-parser": "^5.8.0",
    "libxml2-wasm": "^0.7.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "eslint": "^9.39.4",
    "fallow": "^2.85.0",
    "fast-check": "^3.23.0",
    "prettier": "^3.8.3",
    "sepa": "^3.0.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
